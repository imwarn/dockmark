{
  "name": "@dockmark/extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && node ../../scripts/rename-extension-package.mjs",
    "zip:newtab": "npm run build && node ../../scripts/package-newtab-extension.mjs",
    "zip:firefox": "wxt zip -b firefox --mv3 && node ../../scripts/rename-firefox-extension-package.mjs",
    "typecheck": "wxt prepare && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dockmark/core": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
